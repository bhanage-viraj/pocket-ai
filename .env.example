# ─── WhatsApp ───────────────────────────────────────────────
# The bot's number (the 2nd SIM, on the cloned WhatsApp). Country code + number, digits only.
BOT_NUMBER=919800000000
# Your personal number(s). Owners get admin commands and are never rate-limited. Comma-separated.
OWNER_NUMBERS=919811111111
# Who gets replies in private chats: owner | allowlist | all
DM_POLICY=allowlist
# Extra numbers allowed to DM the bot when DM_POLICY=allowlist
ALLOWED_NUMBERS=
# Name the bot uses for itself (also used in the "hey <name>" group trigger)
BOT_NAME=Pocket
# Group text triggers, comma-separated. {name} = BOT_NAME. @mentions and replies always work.
GROUP_TRIGGERS="/ai,hey {name}"

# ─── Model (llama.cpp llama-server) ─────────────────────────
MODEL_PATH=~/models/gemma-3-1b-it-Q4_K_M.gguf
LLM_URL=http://127.0.0.1:8080
# Best value from ./bench/llama-bench.sh on your phone
LLM_THREADS=4
# Context per slot (2 slots: intent + chat)
LLM_CTX=4096
LLM_TIMEOUT_S=120
# Longest reply in tokens (~12 tokens/s on a phone, so 180 = at most ~15 s)
CHAT_MAX_TOKENS=180
CHAT_TEMPERATURE=0.7
# Skip the classifier when no task keyword/link is present (saves a model call on plain chat)
INTENT_PREFILTER=true
# Extra flags passed to llama-server, e.g. "-C 0xC0 --cpu-strict 1" to pin to the big cores
LLM_EXTRA_ARGS=
# Ping the idle model every N s so Android keeps it in RAM (0 = off)
LLM_WARM_S=90

# ─── Behaviour ──────────────────────────────────────────────
# Past user/assistant exchanges kept per chat
HISTORY_TURNS=4
# ...and at most this many characters of them (the phone reads prompts at ~20 tokens/s)
HISTORY_MAX_CHARS=1600
# Group messages NOT addressed to the bot (since its last reply) shown to it as context. 0 = off
GROUP_CONTEXT_LINES=6
# AI messages per minute per non-owner sender
RATE_LIMIT_PER_MIN=6
# Max waiting generations before replying "busy"
QUEUE_MAX=5
# Messages older than this are "late" (backlog after a reconnect): see LATE_REPLY_MAX_S
MAX_MESSAGE_AGE_S=60
# Older messages that were addressed to the bot (/ai, @mention, reply, allowed DM) still get a
# late reply, up to this age. Plain group chatter is only kept as context. 0 = never reply late
LATE_REPLY_MAX_S=86400

# ─── Live info (weather, currency, news/web search) ─────────
# Weather (Open-Meteo), currency (Frankfurter), news (Google News RSS) and Wikipedia need no key.
WEB=true
# City for "weather?" when none is named (else the bot asks once and remembers per chat)
DEFAULT_CITY=
# Optional: full web search. Free key (2,000 searches/month): https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# ─── Updates ────────────────────────────────────────────────
# The phone pulls new commits from GitHub this often and restarts what changed. 0 = off
UPDATE_INTERVAL_S=300

# ─── Paths / logs ───────────────────────────────────────────
DATA_DIR=./data
AUTH_DIR=./auth
LOG_LEVEL=info

# ─── Claude via the Mac bridge (bridge/server.js) ───────────
# /claude <question> (anyone in groups, owners in DMs) and /code <task> (owners) go to Claude Code
# on the Mac. Use the Mac's Tailscale address. Empty = off.
MAC_BRIDGE_URL=
BRIDGE_TOKEN=
# /claude requests per hour for non-owners
CLAUDE_PER_HOUR=10

# ─── Voice notes + GIFs (scripts/setup-media.sh installs everything) ───
# Voice -> whisper.cpp transcript; GIF/sticker/photo -> small vision model description.
# Answered in DMs, and in groups when it's a reply to the bot. off = ignore media
MEDIA=on
WHISPER_MODEL=~/models/ggml-base-q5_1.bin
# auto | en | hi …  (auto handles Hinglish)
WHISPER_LANG=auto
VOICE_MAX_S=120
VISION_URL=http://127.0.0.1:8081
MEDIA_THREADS=2
# Flags for the vision server; empty = LLM_EXTRA_ARGS with the CPU mask flipped to the other cores
# VISION_EXTRA_ARGS=
STICKER_FONT=/system/fonts/DroidSans-Bold.ttf

# ─── Reminders / summaries ──────────────────────────────────
# IANA timezone for reminders (empty = the phone's own setting)
TIMEZONE=
# Max group messages /summary reads (more = slower on the phone)
SUMMARY_MAX_LINES=40

# ─── Personal ───────────────────────────────────────────────
# Deadline screenshots: remind at this local time on the due day
DEADLINE_REMIND_AT=00:00
# Morning brief to the owner (also /brief 07:30)
BRIEF_TIME=08:00
