# Mac bridge config (copy to bridge/.env). The same BRIDGE_TOKEN goes into the phone's .env.
# Make one with:  openssl rand -hex 24
BRIDGE_TOKEN=
BRIDGE_PORT=7777
# Listen address. 0.0.0.0 = all interfaces; set your Tailscale IP (100.x.y.z) to accept only tailnet traffic.
BRIDGE_HOST=0.0.0.0
# Projects /code may work on: name=path, comma-separated. First one is the default.
BRIDGE_PROJECTS=pocket-ai=~/Desktop/whatsapp
# Kill a Claude run after this many seconds
BRIDGE_TIMEOUT_S=900
CLAUDE_BIN=claude
